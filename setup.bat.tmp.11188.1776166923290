@echo off
setlocal

echo ============================================================
echo  faceswap-stream_DFM - Windows environment setup
echo ============================================================

:: --- Check Python ---
where python >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Python not found on PATH.
    echo Install Python 3.11+ from https://www.python.org/downloads/
    exit /b 1
)

for /f "tokens=2" %%v in ('python --version 2^>^&1') do set PYVER=%%v
echo Found Python %PYVER%

:: --- Create venv ---
if not exist ".venv" (
    echo.
    echo [1/3] Creating virtual environment in .venv ...
    python -m venv .venv
    if errorlevel 1 (
        echo [ERROR] venv creation failed.
        exit /b 1
    )
) else (
    echo [1/3] Virtual environment .venv already exists - skipping.
)

:: --- Activate + upgrade pip ---
echo.
echo [2/3] Upgrading pip ...
call .venv\Scripts\activate.bat
python -m pip install --upgrade pip wheel setuptools
if errorlevel 1 (
    echo [ERROR] pip upgrade failed.
    exit /b 1
)

:: --- Install requirements ---
echo.
echo [3/3] Installing requirements ...
pip install -r requirements.txt
if errorlevel 1 (
    echo [ERROR] requirements installation failed.
    exit /b 1
)

echo.
echo ============================================================
echo  Setup complete.
echo.
echo  Next steps:
echo    1. Activate venv:    .venv\Scripts\activate
echo    2. Download models:  python models\download_models.py
echo    3. Run pipeline:     python -m src.main --profile live
echo ============================================================

endlocal
